{
  "name": "mcp-server-zuuna",
  "version": "0.3.0",
  "description": "MCP server for Zuuna \u2014 agent-native board access for Claude Code, Cursor and Codex. 73 tools over the Zuuna v1 API: boards, cards, comments, checklists, relations, attachments, time tracking, sprints, recurring cards, releases, deployments, webhooks and git-on-board linking.",
  "license": "MIT",
  "author": "kenzotp",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-zuuna": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://zuuna.de/en/kanban-board-for-ai-agents?utm_source=npm&utm_medium=bio&utm_campaign=mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenzotp/mcp-server-zuuna.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zuuna",
    "claude",
    "git",
    "kanban",
    "project-management",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "ZUUNA_E2E=1 vitest run test/e2e.test.ts",
    "serve": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.0.1"
  },
  "mcpName": "io.github.kenzotp/mcp-server-zuuna"
}
